    "",
    "Grok — grok -m <ID>(默认:youpai-grok-4.6)",
    " - 模型:youpai-grok-4.6、grok-4.6、grok-4.5",
    "",
    "OpenCode — opencode --auto -m <provider>/<model>",
    " - 模型:youpai/gpt-5.6-sol、opencode/glm-5.2、opencode/gemini-3.1-pro …",
    "",
    "MiMo Code — mimo --yolo -m <provider>/<model>",
    " - 模型:mimo/mimo-auto、xiaomi/mimo-v2.5、xiaomi/mimo-v2.5-pro、xiaomi/mimo-v2.5-pro-ultraspeed",
    "",
    "Pi — pi --provider <名> --model <pattern>(默认:zai-coding-cn/glm-5.3)",
