  "tiers": {
    "simple": {
      "controller": "mimo --yolo --trust -m xiaomi/mimo-v2.5",
      "worker": "kimi"
    },
    "medium": {
      "controller": "opencode --auto -m youpai/gpt-5.6-sol",
      "worker": "kimi"
    },
